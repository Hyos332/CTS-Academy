@startuml secuenciaDiseño
!theme plain
skinparam style strictuml
autonumber
skinparam roundcorner 5
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Tech Leader" as actor
participant "SPA Client\n(React 18 / Vite)" as spa
participant "Reverse Proxy\n(Nginx Gateway)" as proxy
participant "TechLeaderController\n(NestJS)" as ctrl
participant "RolesGuard('LIDER_EQUIPO')\n(NestJS)" as guard
participant "TechLeaderService\n(Application Service)" as svc
participant "EmailService\n(Nodemailer / SES)" as mailer
database "PostgreSQL 16\n(Prisma ORM)" as db

actor -> spa : Redacta observaciones de cambio y pulsa "Solicitar Cambios"
activate spa

spa -> proxy : POST /api/v1/formacion/tech-lead/entregas/:id/solicitar-cambios\nPayload: { feedbackGeneral, calificacionProvisional: 5.5 }
activate proxy

proxy -> ctrl : Proxy HTTP Request
activate ctrl

ctrl -> guard : canActivate(context)
activate guard
guard --> ctrl : authorized: true (rol: 'LIDER_EQUIPO')
deactivate guard

ctrl -> svc : requestChanges(entregaId: string, userId: string, dto: SolicitarCambiosDto)
activate svc

svc -> db : entregas_laboratorio.findUnique({\n  where: { id: entregaId },\n  include: { alumno: { include: { usuario: true } }, laboratorio: true }\n})
activate db
db --> svc : entregaRecord
deactivate db

svc -> db : entregas_laboratorio.update({\n  where: { id: entregaId },\n  data: {\n    estado: 'CAMBIOS_SOLICITADOS',\n    calificacion: dto.calificacionProvisional ?? null,\n    feedback_general: dto.feedbackGeneral,\n    tech_leader_id: userId,\n    fecha_calificacion: NOW()\n  }\n})
activate db
db --> svc : entregaActualizada
deactivate db

svc -> mailer : sendChangeRequestEmail({\n  to: entregaRecord.alumno.usuario.email,\n  laboratorio: entregaRecord.laboratorio.titulo,\n  feedback: dto.feedbackGeneral\n})
activate mailer
mailer --> svc : emailEnviado
deactivate mailer

svc --> ctrl : SolicitarCambiosResponseDto {\n  entregaId, estado: 'CAMBIOS_SOLICITADOS',\n  fechaCalificacion: entregaActualizada.fecha_calificacion\n}
deactivate svc

ctrl --> proxy : 200 OK (JSON Data)
deactivate ctrl

proxy --> spa : 200 OK
deactivate proxy

spa --> actor : Notifica solicitud de cambios enviada al alumno
deactivate spa

@enduml
