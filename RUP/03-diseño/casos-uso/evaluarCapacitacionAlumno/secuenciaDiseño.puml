@startuml secuenciaDiseño
!theme plain
skinparam style strictuml
autonumber
skinparam roundcorner 5
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Tech Leader" as actor
participant "SPA Client\n(React 18 / Vite)" as spa
participant "Reverse Proxy\n(Nginx Gateway)" as proxy
participant "TechLeaderController\n(NestJS)" as ctrl
participant "RolesGuard('LIDER_EQUIPO')\n(NestJS)" as guard
participant "TechLeaderService\n(Application Service)" as svc
database "PostgreSQL 16\n(Prisma ORM)" as db

actor -> spa : Introduce veredicto sumativo del becario y confirma
activate spa

spa -> proxy : POST /api/v1/formacion/tech-lead/alumnos/:id/evaluacion-sumativa\nPayload: { notaFinalPractica: 9.2, informeDesempeno, aptoPromocion: true }
activate proxy

proxy -> ctrl : Proxy HTTP Request
activate ctrl

ctrl -> guard : canActivate(context)
activate guard
guard --> ctrl : authorized: true (rol: 'LIDER_EQUIPO')
deactivate guard

ctrl -> svc : evaluateStudent(alumnoId: string, userId: string, dto: EvaluacionSumativaDto)
activate svc

svc -> db : alumnos_profer.findUnique({\n  where: { id: alumnoId },\n  include: { equipo: true, usuario: true }\n})
activate db
db --> svc : alumnoRecord
deactivate db

alt el TL no dirige el squad del alumno
    svc --> ctrl : throw ForbiddenException("No puedes calificar a alumnos de otro equipo")
    ctrl --> proxy : 403 Forbidden
    proxy --> spa : 403 Forbidden
    spa --> actor : Muestra advertencia
else evaluación autorizada
    svc -> db : evaluaciones_sumativas.create({\n  data: {\n    alumno_id: alumnoId,\n    tech_leader_id: userId,\n    nota_final_practica: dto.notaFinalPractica,\n    informe_desempeno: dto.informeDesempeno,\n    apto_promocion: dto.aptoPromocion,\n    evaluado_en: NOW()\n  }\n})
    activate db
    db --> svc : evaluacionSumativa
    deactivate db

    svc --> ctrl : EvaluacionSumativaResponseDto {\n  id: evaluacionSumativa.id, alumnoId,\n  notaFinalPractica: evaluacionSumativa.nota_final_practica,\n  aptoPromocion: evaluacionSumativa.apto_promocion,\n  fechaEvaluacion: evaluacionSumativa.evaluado_en\n}
    deactivate svc

    ctrl --> proxy : 201 Created (JSON Data)
    deactivate ctrl

    proxy --> spa : 201 Created
    deactivate proxy

    spa --> actor : Notifica dictamen sumativo registrado exitosamente
    deactivate spa
end

@enduml
