# Entorno de ejecución
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Base de datos PostgreSQL con soporte Multi-Schema (motor_equipos, motor_evaluacion, motor_formacion)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cts_academy?schema=motor_equipos"

# Autenticación JWT
JWT_SECRET="cts_academy_super_secret_development_key_change_in_production_2026"
JWT_EXPIRATION=86400

# Redis Cache & BullMQ
REDIS_HOST="localhost"
REDIS_PORT=6379

# Docker Engine Sandbox (Ejecución de código de candidatos)
DOCKER_SOCKET_PATH="/var/run/docker.sock"
